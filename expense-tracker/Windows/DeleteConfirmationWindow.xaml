<Window x:Class="expense_tracker.Windows.DeleteConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:expense_tracker.Models"
        mc:Ignorable="d"
        Title="Transaktion löschen"
        Height="270"
        Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="DeleteConfirmationWindowTitle"
                   Text="Transaktion löschen"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Text="Möchten Sie die Transaktion wirklich löschen?"
                   FontSize="14"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>

        <CheckBox Grid.Row="2"
                  x:Name="ChkDontShowAgain"
                  Content="Diese Nachricht nicht mehr anzeigen"
                  Foreground="{StaticResource SecondaryTextBrush}"
                  Margin="0,0,0,20"/>


        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Löschen"
                    Width="105"
                    Height="38"
                    HorizontalAlignment="Left"
                    Background="{StaticResource ExpenseBrush}"
                    Foreground="{StaticResource BackgroundBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Padding="18,8"
                    Click="DeleteTransaction_Click"/>

            <Button Grid.Column="1"
                    Content="Abbrechen"
                    Height="38"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelDeletion_Click"/>

        </Grid>

    </Grid>

</Window>