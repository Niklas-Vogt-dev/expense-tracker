<Window x:Class="expense_tracker.Windows.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:expense_tracker.Models"
        mc:Ignorable="d"
        Title="Transaktion"
        Height="630"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        ResizeMode="NoResize">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock x:Name="TransactionWindowTitle"
                       Text="Transaktion anlegen"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <TextBlock Text="Neue Transaktion erfassen"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="13"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- FORM -->

        <StackPanel Grid.Row="1">

            <!-- AMOUNT -->

            <TextBlock Text="Betrag"
                       Style="{StaticResource LabelStyle}"/>

            <TextBox x:Name="TxtAmount"
                     Margin="0,0,0,18"/>

            <!-- TYPE -->

            <TextBlock Text="Typ"
                       Style="{StaticResource LabelStyle}"/>

            <ComboBox x:Name="CmbType"
                      Width="220"
                      Height="38"
                      HorizontalAlignment="Left"
                      SelectedIndex="0"
                      Margin="0,0,0,18">

                <ComboBoxItem Content="Einzahlung"/>
                <ComboBoxItem Content="Ausgabe"/>

            </ComboBox>

            <!-- CATEGORY -->

            <TextBlock Text="Kategorie"
                       Style="{StaticResource LabelStyle}"/>

            <ComboBox x:Name="CmbCategory"
                      Width="220"
                      Height="38"
                      HorizontalAlignment="Left"
                      SelectedIndex="6"
                      Margin="0,0,0,18">

                <ComboBoxItem Content="Essen"/>
                <ComboBoxItem Content="Miete"/>
                <ComboBoxItem Content="Transport"/>
                <ComboBoxItem Content="Entertainment"/>
                <ComboBoxItem Content="Shopping"/>
                <ComboBoxItem Content="Lohn"/>
                <ComboBoxItem Content="Sonstiges"/>

            </ComboBox>

            <!-- DESCRIPTION -->

            <TextBlock Text="Beschreibung"
                       Style="{StaticResource LabelStyle}"/>

            <TextBox x:Name="TxtDescription"
                     Margin="0,0,0,18"/>

            <!-- DATE -->

            <TextBlock Text="Datum"
                       Style="{StaticResource LabelStyle}"/>

            <DatePicker x:Name="DatePicker"
                        Margin="0,0,0,10"/>

        </StackPanel>

        <!-- BUTTONS -->

        <Grid Grid.Row="2"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Speichern"
                    Height="38"
                    HorizontalAlignment="Left"
                    Style="{StaticResource PrimaryButton}"
                    Click="SaveButton_Click"/>

            <Button Grid.Column="1"
                    Content="Abbrechen"
                    Height="38"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"/>

        </Grid>

    </Grid>

</Window>