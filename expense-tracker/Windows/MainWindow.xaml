<Window x:Class="expense_tracker.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:expense_tracker.Models"
        mc:Ignorable="d"
        Title="Expense Tracker"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== -->
        <!-- HEADER -->
        <!-- ==================== -->

        <Grid Grid.Row="0"
      Margin="0,0,0,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock FontSize="30"
                           FontWeight="Bold">

            <Run Text="Hallo "/>
            <Run Text="{Binding UserName}"/>
            <Run Text=" 👋"/>

                </TextBlock>

                <TextBlock Text="Deine Finanzen im Überblick"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Width="40"
                    Height="40"
                    Content="⚙"
                    FontSize="20"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="Settings_Click"/>

        </Grid>

        <!-- ==================== -->
        <!-- MAIN CONTENT -->
        <!-- ==================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- TRANSACTIONS -->

                <ColumnDefinition Width="2.2*"/>

                <!-- DASHBOARD -->

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>

            <!-- ==================== -->
            <!-- TRANSACTIONS -->
            <!-- ==================== -->

            <Grid Grid.Column="0"
                  Margin="0,0,20,0">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- TITLE + BUTTONS -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="Transaktionen"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>


                    <Button Grid.Column="1"
                            Content="Hinzufügen"
                            Height="36"
                            Margin="10,0,8,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddTransaction_Click"/>


                    <Button Grid.Column="2"
                            Content="Bearbeiten"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="EditTransaction_Click"/>


                    <Button Grid.Column="3"
                            Content="Löschen"
                            Height="36"
                            Style="{StaticResource SecondaryButton}"
                            Click="DeleteTransaction_Click"/>

                </Grid>

                <!-- SEARCH -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,15">

                    <TextBox x:Name="SearchTextBox"
                             Height="38"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <TextBlock Text="Nach Transaktion suchen ..."
                               Margin="12,9,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               IsHitTestVisible="False">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}"
                                                 Value="">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <!-- TRANSACTION LIST -->

                <Border Grid.Row="2"
                        Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Padding="15">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->

                        <Border Grid.Row="0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource BorderBrush}"
                                Padding="10,8"
                                Margin="0,0,0,2">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Betrag"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>


                                <TextBlock Grid.Column="1"
                                           Text="Kategorie"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>


                                <TextBlock Grid.Column="2"
                                           Text="Beschreibung"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>


                                <TextBlock Grid.Column="3"
                                           Text="Datum"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>

                            </Grid>

                        </Border>

                        <!-- LIST -->

                        <Grid Grid.Row="1">

                            <ListBox x:Name="TransactionList"
                                     ItemsSource="{Binding TransactionsView}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                <ListBox.Resources>

                                    <Style TargetType="ScrollBar"
                                           BasedOn="{StaticResource DarkScrollBar}">
                                    </Style>

                                </ListBox.Resources>

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                Padding="10,13">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                                    <ColumnDefinition Width="100"/>

                                                </Grid.ColumnDefinitions>

                                                <!-- AMOUNT -->

                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal">

                                                    <TextBlock VerticalAlignment="Center"
                                                               FontWeight="Bold">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Type}"
                                                                                 Value="{x:Static local:TransactionType.Income}">

                                                                        <Setter Property="Text"
                                                                                Value="+"/>

                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource IncomeBrush}"/>

                                                                    </DataTrigger>


                                                                    <DataTrigger Binding="{Binding Type}"
                                                                                 Value="{x:Static local:TransactionType.Expense}">

                                                                        <Setter Property="Text"
                                                                                Value="−"/>

                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource ExpenseBrush}"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>


                                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N2} €}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter Property="FontWeight"
                                                                        Value="SemiBold"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding Type}"
                                                                                 Value="{x:Static local:TransactionType.Income}">

                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource IncomeBrush}"/>

                                                                    </DataTrigger>


                                                                    <DataTrigger Binding="{Binding Type}"
                                                                                 Value="{x:Static local:TransactionType.Expense}">

                                                                        <Setter Property="Foreground"
                                                                                Value="{StaticResource ExpenseBrush}"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </StackPanel>

                                                <!-- CATEGORY -->

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Category}"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <!-- DESCRIPTION -->

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Description}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,15,0"/>

                                                <!-- DATE -->

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                            <!-- EMPTY STATE -->

                            <TextBlock Text="Keine Transaktionen gefunden."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding TransactionsView.Count}"
                                                         Value="0">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

            <!-- ==================== -->
            <!-- DASHBOARD -->
            <!-- ==================== -->

            <StackPanel Grid.Column="1">

                <!-- BALANCE CARD -->

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Padding="25"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Kontostand"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Balance, StringFormat={}{0:N2} €}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Aktueller Kontostand"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

                <!-- MONTHLY EXPENSES CARD -->

                <Border Background="{StaticResource CardBrush}"
                        CornerRadius="10"
                        Padding="25">

                    <StackPanel>

                        <Grid Margin="0,0,0,8">

                            <TextBlock Text="Ausgaben"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Grid HorizontalAlignment="Right">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>

                                <!-- BACKWARDS -->
                                <Button Grid.Column="0"
                                        Content="◀"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="25"
                                        Height="25"
                                        Padding="0"
                                        Click="PreviousMonth_Click"/>

                                <!-- MONTH -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedMonth}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>

                                <!-- FORWARDS -->
                                <Button Grid.Column="2"
                                        Content="▶"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="25"
                                        Height="25"
                                        Padding="0"
                                        Click="NextMonth_Click"
                                        Visibility="{Binding CanGoToNextMonth,
                                                             Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            </Grid>

                        </Grid>

                        <TextBlock Text="{Binding MonthlyExpenses, StringFormat={}{0:N2} €}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ExpenseBrush}"
                                   Margin="0,8,0,20"/>

                        <!-- CATEGORYS -->

                        <ItemsControl ItemsSource="{Binding ExpenseCategories}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>
                                    
                                    <StackPanel Margin="0,0,0,14">

                                        <Grid Margin="0,0,0,5">

                                            <StackPanel Orientation="Horizontal">
                                                
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="13"/>

                                                <TextBlock Text="{Binding Amount, StringFormat={}  {0:N2} €}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="12"
                                                           Margin="8,0,0,0"/>
                                                
                                            </StackPanel>

                                            <TextBlock Text="{Binding Percentage, StringFormat={}{0:0}%}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"/>

                                        </Grid>

                                        <ProgressBar Value="{Binding Percentage}"
                                                     Maximum="100"
                                                     Style="{StaticResource ExpenseProgressBar}"/>

                                    </StackPanel>
                                    
                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</Window>